# Скопируйте этот файл в .env и заполните значения.
# .env никогда не должен попадать в git / GitHub.

# Основной AI-шлюз SmartAPI. При наличии этого ключа используется gpt-5.6-luna.
SMARTAPI_API_KEY=
SMARTAPI_BASE_URL=https://api.smartapi.shop/v1
SMARTAPI_MODEL=gpt-5.6-luna

# Ключ Groq API для модели groq/compound. Без него включается офлайн-режим.
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_MODEL_VERSION=latest

# Необязательно. Если оставить пустым, используется локальная SQLite-база
# backend/data/navpedagoga.sqlite — без регистрации и внешних сервисов.
# Для масштабирования можно указать PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Необязательно: путь к локальной SQLite-базе.
DB_PATH=./src/data/navpedagoga.sqlite

# Любая случайная длинная строка для подписи JWT-токенов авторизации.
JWT_SECRET=change-me-to-a-long-random-string

# Порт, на котором запускается сервер.
PORT=4000

# Необязательно: список разрешённых внешних origin через запятую.
# CORS_ORIGIN=

# Секрет для защиты /api/cron/refresh-roadmaps (автообновление карт по расписанию).
# Любая случайная строка — та же, что вы зададите как секрет CRON_SECRET в GitHub Actions.
CRON_SECRET=change-me-too
